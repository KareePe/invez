DB_HOST=localhost
DB_NAME=invez
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Public base URL, no trailing slash. Used to build links inside emails.
# Never derived from the Host header — that would let an attacker send
# themselves a valid reset link pointing at their own domain.
APP_URL=https://example.com

# Must be the hostname on the mail server's TLS certificate. On shared hosting
# that is usually the server name (e.g. thsvNN.provider.com), not your domain.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS="your_smtp_password"
SMTP_FROM_NAME=INVEZ
