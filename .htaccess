Options -Indexes

# Block sensitive files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

RewriteEngine On

# Trailing slash removal (except root)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Member area (must be before -f/-d check because member/ is a real directory)
# RewriteRule ^member/?$               member/index.php       [L]
# RewriteRule ^member/settings$        member/settings.php    [L]
# RewriteRule ^member/articles$        member/articles.php    [L]
# RewriteRule ^member/article-edit$    member/article-edit.php [L,QSA]
# RewriteRule ^member/properties$      member/properties.php  [L]
# RewriteRule ^member/property-edit$   member/property-edit.php [L,QSA]

# Skip real files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pretty URLs
RewriteRule ^lang$               lang.php        [L,QSA]
RewriteRule ^register$           register.php    [L]
RewriteRule ^login$              login.php       [L]
RewriteRule ^logout$             logout.php      [L]
RewriteRule ^about$              about.php       [L]
RewriteRule ^portfolio$          portfolio.php   [L,QSA]
RewriteRule ^content$            content.php     [L]
RewriteRule ^contact$            contact.php     [L]
RewriteRule ^properties$         properties.php  [L,QSA]
RewriteRule ^article/(\d+)$      article.php?id=$1  [L,QSA]
RewriteRule ^property/(\d+)$     property.php?id=$1 [L,QSA]
