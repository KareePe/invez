Options -Indexes

# Block sensitive files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block the git directory — a readable .git lets anyone download the whole
# repository and its history. RedirectMatch (mod_alias) is used instead of a
# <Directory>/Require block so it works the same on Apache 2.2 and 2.4.
# The (/|$) keeps it from catching unrelated names such as .gitkeep.
RedirectMatch 404 /\.git(/|$)

# Security headers. No Content-Security-Policy yet: the pages load Tailwind and
# feather-icons from CDNs and run inline scripts, so a policy would have to be
# designed around those rather than dropped in.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On

# Trailing slash removal (except root)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Member root (needed because member/ is a real directory)
RewriteRule ^member/?$ member/index.php [L]

# Skip real files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pretty URLs
RewriteRule ^lang$               lang.php        [L,QSA]
RewriteRule ^register$           register.php    [L]
RewriteRule ^login$              login.php       [L]
RewriteRule ^forgot-password$    forgot-password.php [L]
RewriteRule ^reset-password$     reset-password.php  [L,QSA]
RewriteRule ^logout$             logout.php      [L]
RewriteRule ^about$              about.php       [L]
RewriteRule ^portfolio$          portfolio.php   [L,QSA]
RewriteRule ^content$            content.php     [L]
RewriteRule ^contact$            contact.php     [L]
RewriteRule ^properties$         properties.php  [L,QSA]
RewriteRule ^article/(\d+)$      article.php?id=$1   [L,QSA]
RewriteRule ^property/(\d+)$     property.php?id=$1  [L,QSA]
RewriteRule ^checkout/([a-z0-9]+)$ checkout.php?token=$1 [L,QSA]
RewriteRule ^member/orders$          member/orders.php   [L]
RewriteRule ^sitemap\.xml$           sitemap.php          [L]
